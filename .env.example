# Aplicación
APP_NAME="Neo-Emporion"
APP_ENV="development"
APP_DEBUG="True"
APP_PORT=8000

# Base de datos
DATABASE_URL="sqlite:///:memory:"

# Seguridad
# Clave para firmar los tokens JWT (HU-07). Si se deja vacía se genera una al azar en cada
# arranque. Para generar una: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
# Duración del token en minutos (60 = 3600 segundos, como el ejemplo de la HU-07)
ACCESS_TOKEN_EXPIRE_MINUTES=60
